  "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Fleet ETA Tracker</title>\n<link rel=\"stylesheet\" href=\"/static/style.css\">\n<link rel=\"stylesheet\" href=\"/static/mobile.css\">\n<link rel=\"stylesheet\" href=\"/static/notebook.css\">\n<link rel=\"stylesheet\" href=\"/static/eta-calc.css\">\n<meta name=\"theme-color\" content=\"#fafafa\">\n</head>\n<body>\n\n<div class=\"topbar\">\n  <h1>Fleet ETA Tracker <span class=\"title-version\">vX.YY</span></h1>\n  <div id=\"disp-hint\" class=\"disp-hint\" hidden></div>\n</div>\n\n<nav class=\"main-tabs\">\n  <button class=\"main-tab-btn active\" data-tab=\"fleet\">Флот</button>\n  <button class=\"main-tab-btn\" data-tab=\"route\">From → To</button>\n  <button class=\"main-tab-btn\" data-tab=\"gf\" data-wip>GF построитель</button>\n  <button class=\"main-tab-btn m-only\" data-tab=\"maps\" data-locator>Локатор</button>\n  <span class=\"main-tabs-spacer\"></span>\n  <button class=\"main-tab-btn ref-tab\" data-tab=\"bans\">Запреты</button>\n  <button class=\"main-tab-btn ref-tab\" data-tab=\"ferries\" data-wip>Паромы</button>\n  <button class=\"main-tab-btn ref-tab\" data-tab=\"maps\">Карты стран</button>\n  <button class=\"main-tab-btn ref-tab\" data-tab=\"truckinfo\" data-wip>Truck Info</button>\n  <button class=\"main-tab-btn ref-tab\" data-tab=\"notes\" title=\"Блокнот\">[.]</button>\n  <a id=\"g-usage\" class=\"g-usage\" href=\"/gusage\" target=\"_blank\" rel=\"noopener\" title=\"Запросы к Google Routes\">G …</a>\n</nav>\n\n<!-- ==================== Вкладка: Флот ==================== -->\n<div id=\"tab-fleet\" class=\"tab-panel\">\n\n<div id=\"sort-bar\" class=\"sort-bar\">\n  <span class=\"own-flt\"><button type=\"button\" data-own=\"all\" title=\"Строки всех диспетчеров\">Все</button><span class=\"own-btns\"></span><span class=\"flt-sep\"></span></span>\n  <span class=\"flt-lbl\">Показать:</span>\n  <button type=\"button\" data-flt=\"all\" title=\"Все строки\">все</button>\n  <button type=\"button\" data-flt=\"L\" title=\"Только погрузки — по первой непройденной точке (если она без отметки — по следующей)\">L</button>\n  <button type=\"button\" data-flt=\"O\" title=\"Только выгрузки — по первой непройденной точке (если она без отметки — по следующей)\">O</button>\n  <span class=\"flt-sep\"></span>\n  <span>Сортировка:</span>\n  <button type=\"button\" data-sort=\"LO\" title=\"Сначала погрузки, потом выгрузки; внутри — по TimeSlot первой непройденной точки (раньше — выше), без TimeSlot — в конце\">L → O</button>\n  <button type=\"button\" data-sort=\"OL\" title=\"Сначала выгрузки, потом погрузки; внутри — по TimeSlot первой непройденной точки, без TimeSlot — в конце\">O → L</button>\n  <button type=\"button\" data-sort=\"manual\" title=\"Свой порядок: перетаскивайте строки за ⠿ (на телефоне — ↑/↓ в меню ⋯); новые строки — в конец\">руками</button>\n  <label class=\"auto-lbl\" title=\"Как часто пересчитывать все строки (без перестановки). Строка, которая стала опаздывать, мигает до клика.\">автообновление\n    <select id=\"auto-refresh\"><option value=\"0\">выкл</option><option value=\"15\">15 мин</option><option value=\"30\">30 мин</option><option value=\"60\">60 мин</option></select></label>\n  <button type=\"button\" class=\"m-edit-btn\" id=\"m-edit-btn\" title=\"Правка строк на телефоне\">✎ правка</button>\n</div>\n<table id=\"fleet-table\">\n  <colgroup>\n    <col class=\"col-unit\">\n    <col class=\"col-status\">\n    <col class=\"col-target\">\n    <col class=\"col-delivery\">\n    <col class=\"col-dist\">\n    <col class=\"col-eta\">\n    <col class=\"col-note\">\n    <col class=\"col-actions\">\n  </colgroup>\n  <thead>\n    <tr>\n      <th>Машина</th>\n      <th>Статус</th>\n      <th class=\"th-center th-target\"><button type=\"button\" id=\"fold-all-btn\" class=\"fold-all-th\" title=\"Развернуть точки во всех строках\">▸</button>Таргет</th>\n      <th class=\"th-center\" title=\"Срок или окно «с–по» для точки: 03.10 15:00 · 03.10 09-15 · 03.10 22:00 – 04.10 06:00\">TimeSlot</th>\n      <th class=\"th-center\" title=\"Дистанция, км\">KM</th>\n      <th class=\"th-eta\">ETA</th>\n      <th>Примечание</th>\n      <th class=\"th-actions\"><button type=\"button\" id=\"add-row-btn\" class=\"refresh-top\" title=\"Добавить строку в конец\">+<span class=\"hdr-txt\"> строка</span></button><button type=\"button\" id=\"refresh-btn\" class=\"refresh-top\" title=\"Обновить всё\">↻</button></th>\n    </tr>\n  </thead>\n  <tbody id=\"fleet-tbody\"></tbody>\n</table>\n\n\n<!-- v3.26: «Карта 2.0» — карта Флота в выезжающей панели справа (язычок 🗺 над 📓); на телефоне — как раньше, во весь экран -->\n<aside id=\"map-panel\" class=\"map-panel\" aria-hidden=\"true\">\n  <div class=\"map-resize\" title=\"Потянуть — шире / уже (ширина запоминается)\"></div>\n  <div id=\"map\"></div>\n</aside>\n<button type=\"button\" class=\"map-tab\" id=\"map-tab\" title=\"Карта Флота (Esc — закрыть)\">🗺</button>\n<!-- v3.28: ⏱ ETA-калькулятор — язычок под 📓, панель строит static/eta-calc.js -->\n<button type=\"button\" class=\"calc-tab\" id=\"calc-tab\" title=\"ETA-калькулятор (Esc — закрыть)\">⏱</button>\n<button type=\"button\" class=\"m-map-close\" id=\"m-map-close\">← К списку</button>\n<button type=\"button\" class=\"m-fab\" id=\"m-fab-add\" title=\"Добавить строку\" hidden>+</button>\n<button type=\"button\" class=\"m-fab\" id=\"m-fab-map\" title=\"Карта\">🗺</button>\n<button type=\"button\" class=\"m-fab\" id=\"m-fab-refresh\" title=\"Обновить всё\">↻</button>\n\n<datalist id=\"units-list\"></datalist>\n<datalist id=\"points-list\"></datalist>\n<datalist id=\"trailers-list\"></datalist>\n<datalist id=\"trucks-list\"></datalist>\n\n</div>\n\n<!-- ==================== Вкладка: Карты стран ==================== -->\n<div id=\"tab-maps\" class=\"tab-panel\" hidden>\n  <div class=\"pc-layout\">\n    <div class=\"pc-top\">\n      <nav class=\"pc-tabs\" role=\"tablist\" aria-orientation=\"vertical\" id=\"pcTabs\"></nav>\n      <div class=\"locator-bar\">\n        <button type=\"button\" id=\"locatorBtn\" class=\"locator-btn\">Локатор</button>\n        <input id=\"locatorInput\" list=\"points-list\" autocomplete=\"off\" placeholder=\"код, город, GPS или машина\">\n      </div>\n    </div>\n    <div id=\"locatorView\" class=\"locator-view\" hidden>\n      <div id=\"locatorInfo\" class=\"locator-info\">Клик по точке — код региона. Или введите код, город, GPS или машину в поле выше и нажмите Enter.</div>\n      <div id=\"locatorMap\" class=\"locator-map\"></div>\n      <div class=\"locator-credit\">Коды регионов AT, CH, HU и др.: © <a href=\"https://www.geonames.org\" target=\"_blank\" rel=\"noopener\">GeoNames</a> (<a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener\">CC BY 4.0</a>)</div>\n    </div>\n    <main class=\"pc-main\" id=\"pcMain\">\n      <div class=\"pc-toolbar\">\n        <h2 id=\"pcTitle\"></h2>\n        <button type=\"button\" id=\"pcZoomBtn\">Увеличить</button>\n        <a id=\"pcOrigLink\" target=\"_blank\" rel=\"noopener\">Открыть оригинал</a>\n      </div>\n      <div class=\"pc-viewer\" id=\"pcViewer\" role=\"tabpanel\">\n        <img id=\"pcImg\" alt=\"\">\n        <div class=\"pc-status\" id=\"pcStatus\" hidden></div>\n        <div class=\"pc-zones\" id=\"pcZones\" hidden></div>\n      </div>\n    </main>\n  </div>\n</div>\n\n<!-- ==================== Вкладка: [.] Справка (блокнот, справочная) ==================== -->\n<div id=\"tab-notes\" class=\"tab-panel\" hidden>\n  <div class=\"notes-layout\">\n    <div class=\"notes-main\">\n      <div class=\"notes-head\">\n        <b>Блокнот</b>\n        <span class=\"notes-hint\">сохраняется автоматически в этом браузере</span>\n        <span id=\"notesSaved\" class=\"notes-saved\"></span>\n      </div>\n      <textarea id=\"notesText\" class=\"notes-text\" spellcheck=\"false\" placeholder=\"Заметки, ссылки, номера…\"></textarea>\n      <div class=\"notes-links-title\">Ссылки из заметок</div>\n      <div id=\"notesLinks\" class=\"notes-links\"></div>\n      <div class=\"changelog-head\"><b>История изменений</b> <span id=\"changelogCount\" class=\"notes-hint\"></span></div>\n      <div id=\"changelog\" class=\"changelog\">Загрузка…</div>\n    </div>\n    <aside class=\"notes-side\">\n      <div class=\"notes-side-title\">Адресная база</div>\n      <div id=\"addrStatus\" class=\"addr-status\">Загрузка…</div>\n      <button type=\"button\" id=\"addrRefreshBtn\">↻ Обновить базу</button>\n      <div id=\"addrProblems\" class=\"addr-problems\"></div>\n      <div class=\"notes-side-title\" style=\"margin-top:14px\">База фрахтов</div>\n      <div id=\"frtStatus\" class=\"addr-status\">Загрузка…</div>\n      <button type=\"button\" id=\"frtRefreshBtn\">↻ Обновить фрахты</button>\n      <div class=\"notes-side-title\" style=\"margin-top:14px\">Полезные ссылки</div>\n      <div class=\"fixed-links\">\n        <a href=\"https://claude.ai/settings/usage\" target=\"_blank\" rel=\"noopener\">Лимиты Claude (подписка)</a>\n        <a href=\"https://console.cloud.google.com/billing/reports?project=my-n8n-bot-496614\" target=\"_blank\" rel=\"noopener\">Расходы Google (billing)</a>\n        <a href=\"https://console.cloud.google.com/billing/budgets\" target=\"_blank\" rel=\"noopener\">Бюджеты и уведомления Google</a>\n        <a href=\"https://docs.google.com/spreadsheets/d/1m0oM8cNixVDM1kgQKCZKPgF-aSQN-0loqdLc-dWkD7g/edit\" target=\"_blank\" rel=\"noopener\">Таблица «Fleet Tracker — данные»</a>\n        <a href=\"https://www.mapon.com/pro/online\" target=\"_blank\" rel=\"noopener\">Mapon — веб-кабинет</a>\n        <div class=\"fixed-links-sub\">Наша аппа</div>\n        <a href=\"/notebook\" target=\"_blank\" rel=\"noopener\">Блокнот — вся таблица</a>\n        <a href=\"/gusage\" target=\"_blank\" rel=\"noopener\">Лог запросов к Google по суткам и часам</a>\n        <a href=\"/api/google-usage\" target=\"_blank\" rel=\"noopener\">Счётчик G (JSON)</a>\n        <a href=\"/api/mapon-check\" target=\"_blank\" rel=\"noopener\">Проверка связи с Mapon</a>\n        <a href=\"/api/mapon-check?tacho=1\" target=\"_blank\" rel=\"noopener\">Тахограф: у каких машин нет подписки Mapon</a>\n        <a href=\"/api/me\" target=\"_blank\" rel=\"noopener\">Под каким аккаунтом вошёл</a>\n        <a href=\"/api/changelog\" target=\"_blank\" rel=\"noopener\">История версий (JSON)</a>\n        <a href=\"/api/freights?refresh=1\" target=\"_blank\" rel=\"noopener\">Перечитать базу фрахтов сейчас</a>\n        <a href=\"/api/bans\" target=\"_blank\" rel=\"noopener\">Фид запретов (JSON)</a>\n        <a href=\"/api/dispatchers\" target=\"_blank\" rel=\"noopener\">Диспетчеры из листа (JSON)</a>\n        <a href=\"/api/fleet/trash\" target=\"_blank\" rel=\"noopener\">Корзина Флота (JSON)</a>\n        <div class=\"fixed-links-sub\">Google Cloud</div>\n        <a href=\"https://console.cloud.google.com/run/detail/europe-west1/fleet-eta-tracker/metrics?project=my-n8n-bot-496614\" target=\"_blank\" rel=\"noopener\">Cloud Run — сервис, метрики</a>\n        <a href=\"https://console.cloud.google.com/run/detail/europe-west1/fleet-eta-tracker/logs?project=my-n8n-bot-496614\" target=\"_blank\" rel=\"noopener\">Cloud Run — логи</a>\n        <a href=\"https://console.cloud.google.com/cloud-build/builds?project=my-n8n-bot-496614\" target=\"_blank\" rel=\"noopener\">Cloud Build — история деплоев</a>\n        <a href=\"https://console.cloud.google.com/firestore/databases/-default-/data?project=my-n8n-bot-496614\" target=\"_blank\" rel=\"noopener\">Firestore — данные</a>\n        <a href=\"https://console.cloud.google.com/security/iap?project=my-n8n-bot-496614\" target=\"_blank\" rel=\"noopener\">IAP — кто имеет вход</a>\n        <a href=\"https://console.cloud.google.com/apis/api/routes.googleapis.com/metrics?project=my-n8n-bot-496614\" target=\"_blank\" rel=\"noopener\">Routes API — метрики</a>\n        <a href=\"https://console.cloud.google.com/apis/api/routes.googleapis.com/quotas?project=my-n8n-bot-496614\" target=\"_blank\" rel=\"noopener\">Routes API — квоты</a>\n        <a href=\"https://console.cloud.google.com/google/maps-apis/metrics?project=my-n8n-bot-496614\" target=\"_blank\" rel=\"noopener\">Google Maps — все запросы</a>\n        <div class=\"fixed-links-sub\">GitHub</div>\n        <a href=\"https://github.com/LVAHEAD/fleet-tracker\" target=\"_blank\" rel=\"noopener\">Репозиторий</a>\n        <a href=\"https://github.com/LVAHEAD/fleet-tracker/blob/main/BACKLOG.md\" target=\"_blank\" rel=\"noopener\">BACKLOG.md — план и хотелки</a>\n        <a href=\"https://github.com/LVAHEAD/fleet-tracker/blob/main/CHANGELOG.md\" target=\"_blank\" rel=\"noopener\">CHANGELOG.md — история версий</a>\n      </div>\n    </aside>\n  </div>\n</div>\n\n<!-- ==================== Вкладка: Запреты (справочная) ==================== -->\n<div id=\"tab-bans\" class=\"tab-panel\" hidden>\n  <div class=\"bans-head\">\n    <div id=\"bansNow\" class=\"bans-now\">Загрузка…</div>\n    <button type=\"button\" id=\"bansRefresh\" class=\"bans-refresh\">↻ Обновить</button>\n  </div>\n  <div id=\"bansCalendar\" class=\"bans-calendar\"></div>\n  <div class=\"bans-legend\">\n    <span class=\"ban-chip ban-full\">DE</span> запрет по всей стране (воскресенье, праздник)\n    <span class=\"ban-chip ban-part\">AT</span> отдельные дороги / участки\n    <span class=\"ban-chip ban-full ban-ours\">DE</span> страна, где сейчас машина или её таргет\n    · запреты только для ADR скрыты\n  </div>\n  <p class=\"bans-note\">Данные: <a href=\"https://nakordoni.eu/\" target=\"_blank\" rel=\"noopener\">nakordoni.eu</a>, обновляются раз в 30 минут; информация справочная — критичные рейсы сверяйте с официальными источниками.\n    Показаны только страны, где мы ездим.</p>\n</div>\n\n<!-- ==================== Вкладка: Паромы (справочная) ==================== -->\n<div id=\"tab-ferries\" class=\"tab-panel\" hidden>\n  <p class=\"ferries-note\">Расписания паромов. Клик по картинке — открыть в полный размер. Пометки терминалов: vuos — Vuosaari, Lansi — Länsisatama (West Harbour), TermA — Terminal A, muuga — Muuga.</p>\n  <a href=\"/static/ferries/ferries.jpg\" target=\"_blank\" rel=\"noopener\" class=\"ferries-link\">\n    <img src=\"/static/ferries/ferries.jpg\" alt=\"Расписания паромов: Helsinki–Tallinn, Rostock–Gedser\" class=\"ferries-img\">\n  </a>\n</div>\n\n<!-- ==================== Вкладка: GF построитель (заглушка, v1.49) ==================== -->\n<div id=\"tab-gf\" class=\"tab-panel\" hidden>\n  <div class=\"truckinfo-empty\">\n    <b>Построитель маршрута GreenFood H-XXX</b>\n  </div>\n</div>\n\n<!-- ==================== Вкладка: Truck Info (рабочая) ==================== -->\n<div id=\"tab-truckinfo\" class=\"tab-panel\" hidden>\n  <div class=\"ti-form\">\n    <input id=\"ti-unit\" list=\"units-list\" placeholder=\"номер трака\" autocomplete=\"off\">\n    <button id=\"ti-go\" type=\"button\">Показать</button>\n    <span class=\"ti-hint\">время — LV (Рига)</span>\n  </div>\n  <p class=\"ti-warn\">Информация носит информативный характер. Мапон может считать не точно!</p>\n  <div id=\"ti-out\" class=\"ti-out\">\n    <div class=\"truckinfo-empty\">\n      <b>Truck Info — проверка машины</b>\n      <p>Водители, недельные отдыхи 24 / 45 ч и срок следующего, вставка/извлечение карт, стоянки за 3 суток.</p>\n    </div>\n  </div>\n</div>\n\n<!-- ==================== Вкладка: From → To ==================== -->\n<div id=\"tab-route\" class=\"tab-panel\" hidden>\n  <div class=\"route-form\">\n    <div class=\"route-group\">\n      <div class=\"route-group-title\">From — погрузки</div>\n      <div id=\"route-from-list\" class=\"route-list\"></div>\n    </div>\n    <span class=\"route-arrow\">→</span>\n    <div class=\"route-group\">\n      <div class=\"route-group-title\">To — выгрузки</div>\n      <div id=\"route-to-list\" class=\"route-list\"></div>\n    </div>\n    <div class=\"route-buttons\">\n      <button id=\"route-calc-btn\">Рассчитать</button>\n      <button id=\"route-clear-btn\" class=\"route-clear-btn\">Очистить</button>\n    </div>\n  </div>\n  <p class=\"route-note\">В поле можно вписать машину (номер), код региона, GPS или город. Маршрут строится строго по порядку: From1 → From2 → … → To1 → To2 → …. Оценка по центрам почтовых зон — для больших зон (север Швеции/Норвегии) погрешность может быть заметной.</p>\n  <div id=\"route-geo-warn\" class=\"route-geo-warn\" hidden></div>\n  <div id=\"route-result\" class=\"route-result\" hidden>\n    <div class=\"route-result-row route-total\"><b id=\"route-dist\"></b> км &nbsp;·&nbsp; в пути ~<b id=\"route-duration\"></b> (при 70 км/ч)\n      <button type=\"button\" id=\"route-to-calc\" class=\"route-to-calc\" title=\"Открыть ⏱ ETA-калькулятор с первым отрезком: км, линия на мини-карту, тахограф машины (если From — машина)\">⏱ Послать в калькулятор</button></div>\n    <div id=\"route-legs\"></div>\n    <div id=\"route-corridor\" class=\"route-cor\" hidden></div>\n    <div id=\"route-bans\" class=\"route-bans\" hidden></div>\n    <div class=\"route-result-row route-waypoint-note\" id=\"route-waypoint-note\" hidden>Маршрут скорректирован по вашему правилу (обход/паромы)</div>\n  </div>\n  <div id=\"route-points\" class=\"route-points\" hidden></div>\n  <div id=\"route-freights\" class=\"route-freights\" hidden></div>\n  <div id=\"route-error\" class=\"route-error\" hidden></div>\n  <div id=\"route-map\"></div>\n</div>\n\n<div class=\"version-tag\">vX.YY</div>\n\n<script src=\"/static/notebook.js\"></script>\n<script src=\"/static/sync.js\"></script>\n<script src=\"/static/app.js\"></script>\n<script src=\"/static/map-panel.js\"></script>\n<script src=\"/static/eta-calc.js\"></script>\n<script src=\"/static/postcode-maps.js\"></script>\n<script src=\"/static/route-tab.js\"></script>\n<script src=\"/static/locator.js\"></script>\n<script src=\"/static/notes.js\"></script>\n<script src=\"/static/bans-tab.js\"></script>\n<script src=\"/static/truckinfo.js\"></script>\n<script src=\"/static/gusage.js\"></script>\n<script src=\"/static/changelog.js\"></script>\n<script src=\"/static/wip.js\"></script>\n<script src=\"/static/mobile.js\"></script>\n<script src=\"https://maps.googleapis.com/maps/api/js?key=g&libraries=geometry&callback=initMap\" async defer></script>\n</body>\n</html>"
 ],
